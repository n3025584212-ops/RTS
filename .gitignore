# Godot 4+
.godot/

# Imported/exported build output
/export/
/build/
/dist/

# Local runtime logs
*.log

# Godot 4+ import metadata — regenerated by the editor and by CI on every import.
# This project has never tracked them (git ls-files "*.import" / "*.uid" = 0), so they are
# ignored to keep the worktree clean rather than committed.
# NOTE: Godot recommends committing *.import and *.uid once several people or machines build
# the project; if that ever happens, remove these two lines and commit them instead.
*.import
*.uid

# OS/editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/
